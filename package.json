{
  "name": "observanda",
  "version": "0.3.0-dev.20261019.2",
  "private": true,
  "description": "An independent notebook for observation, experimentation, and sharing.",
  "type": "module",
  "engines": {
    "node": ">=24.20 <25"
  },
  "scripts": {
    "start": "node src/cli.js open",
    "predesktop": "node node_modules/electron/install.js",
    "desktop": "electron desktop",
    "prepare:desktop": "node scripts/prepare-desktop.js",
    "package:desktop": "electron-builder --config electron-builder.config.js --publish never",
    "pretest:desktop": "node node_modules/electron/install.js",
    "test:desktop": "playwright test --config playwright.desktop.config.js",
    "test": "node scripts/test.js",
    "check": "node scripts/check.js",
    "test:browser": "node scripts/test.js --browser",
    "build:editor": "node scripts/build-editor.js",
    "qualify:server": "node scripts/test.js test/cli-security.test.js test/postgres.test.js test/postgres-modules.test.js test/postgres-runtime.test.js test/server-lifecycle.test.js test/jobs.test.js test/jobs-server.test.js test/access-server.test.js",
    "build:tools": "node scripts/build-tools.js",
    "build:hashes": "node scripts/build-hashes.js",
    "build:json": "node scripts/build-json.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsqr": "1.4.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@noble/hashes": "2.4.0",
    "@peculiar/x509": "2.1.0",
    "@resvg/resvg-wasm": "2.6.2",
    "fontkit": "2.0.4",
    "ical.js": "2.2.1",
    "katex": "0.19.0",
    "mathjs": "15.2.0",
    "openchemlib": "9.25.0",
    "parse5": "8.0.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.16.3",
    "prosemirror-collab": "1.3.1",
    "prosemirror-model": "1.25.12",
    "prosemirror-transform": "1.12.2",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "saxes": "6.0.0",
    "stream-chain": "4.2.6",
    "stream-json": "3.7.0"
  },
  "overrides": {
    "@electron/get@3.1.0": {
      "global-agent": "4.1.3"
    }
  }
}
